# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Data & models (regenerable, large)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Live automation: state.json and weekly outputs ARE committed (audit
# trail), but the atomic-write temp files never are. report_latest.html
# is an ephemeral copy for the CI artifact (the dated report under
# live/weekly/<date>/ is the committed record).
live/*.tmp
live/report_latest.html

# Secrets
.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude
.claude/
